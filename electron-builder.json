{
  "appId": "com.fluxora.app",
  "productName": "Fluxora",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "build/icon.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Fluxora",
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "artifactName": "Fluxora-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "Fluxora-Portable-${version}.${ext}"
  },
  "npmRebuild": false,
  "extraMetadata": {
    "main": "dist-electron/electron/main.js"
  }
}