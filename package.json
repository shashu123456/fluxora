{
  "name": "ai-workspace",
  "version": "1.0.0",
  "description": "Local-first desktop AI workspace for coding, memory, and project intelligence",
  "author": "Shashank Gowda N C",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashu123456/fluxora.git"
  },
  "bugs": {
    "url": "https://github.com/shashu123456/fluxora/issues"
  },
  "homepage": "https://github.com/shashu123456/fluxora#readme",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "electron .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:debug": "concurrently -k \"npm run build:electron && wait-on http://localhost:5173\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --config electron-builder.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.9",
    "lucide-react": "^0.344.0",
    "openai": "^4.40.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.33.2",
    "simple-git": "^3.22.0",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^5.0.4",
    "uuid": "^9.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  }
}
